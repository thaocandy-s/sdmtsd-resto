generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== AUTH & ACCESS =====

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String?   @unique
  passwordHash String
  firstName    String
  lastName     String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([roleId])
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  label       String
  description String?
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id        String   @id @default(uuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    String
  action    String
  createdAt DateTime @default(now())

  @@index([roleId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

// ===== RESTAURANT =====

model Restaurant {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  description    String?
  address        String?
  phone          String?
  email          String?
  latitude       Float?
  longitude      Float?
  googlePlaceId  String?
  googleMapQuery String?
  openingHours   Json?
  holidays       Json?
  socialLinks    Json?
  logoUrl        String?
  faviconUrl     String?
  logoSubtitle   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ===== HOME / BANNERS =====

model HeroBanner {
  id             String    @id @default(uuid())
  title          String
  subtitle       String?
  imageUrl       String
  mobileImageUrl String?
  ctaLabel       String?
  ctaUrl         String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ===== FOOD MENU =====

model FoodCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  foods     Food[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Food {
  id            String        @id @default(uuid())
  categoryId    String
  category      FoodCategory  @relation(fields: [categoryId], references: [id])
  name          String
  slug          String        @unique
  description   String?
  price         Int
  originalPrice Int?
  imageUrl      String?
  images        String[]
  isPopular     Boolean       @default(false)
  isRecommended Boolean       @default(false)
  allergens     String[]
  ingredients   String?
  sortOrder     Int           @default(0)
  status        ContentStatus @default(DRAFT)
  calories      Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@index([categoryId])
  @@index([deletedAt, status, sortOrder])
}

// ===== DRINK MENU =====

model DrinkCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  drinks      Drink[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Drink {
  id             String        @id @default(uuid())
  categoryId     String
  category       DrinkCategory @relation(fields: [categoryId], references: [id])
  name           String
  slug           String        @unique
  description    String?
  price          Int
  originalPrice  Int?
  imageUrl       String?
  images         String[]
  isPopular      Boolean       @default(false)
  isRecommended  Boolean       @default(false)
  alcoholPercent Float?
  volume         String?
  sortOrder      Int           @default(0)
  status         ContentStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([categoryId])
  @@index([deletedAt, status, sortOrder])
}

// ===== BUFFET =====

model BuffetCourse {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  price       Int
  duration    Int
  minPeople   Int?
  maxPeople   Int?
  includes    String[]
  isAllMenu   Boolean       @default(false)
  notes       String?
  imageUrl    String?
  images      String[]
  isPopular   Boolean       @default(false)
  sortOrder   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt, status, sortOrder])
}

// ===== MEDIA COVERAGE =====

model MediaCoverage {
  id           String                @id @default(uuid())
  publishedAt  DateTime
  mediaName    String
  title        String
  description  String?
  imageUrl     String
  externalUrl  String
  category     MediaCoverageCategory
  isFeatured   Boolean               @default(false)
  isPublished  Boolean               @default(false)
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?

  @@index([isPublished, sortOrder])
  @@index([category, isPublished])
}

model MediaOutlet {
  id         String   @id @default(uuid())
  name       String
  logoUrl    String
  websiteUrl String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ===== BEER ART =====

model BeerArt {
  id           String   @id @default(uuid())
  title        String
  description  String?
  imageUrl     String
  customerName String?
  artistName   String?
  isPopular    Boolean  @default(false)
  isPublished  Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([isPublished, sortOrder])
}

// ===== KATANUKI CHALLENGE =====

model KatanukiWinner {
  id              String   @id @default(uuid())
  participantName String
  imageUrl        String?
  challengeName   String?
  discountAwarded String?
  completedAt     DateTime
  sortOrder       Int      @default(0)
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model KatanukiRule {
  id          String   @id @default(uuid())
  title       String
  description String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ===== TOURIST GUIDE =====

model TourCategory {
  id        String      @id @default(uuid())
  name      String
  slug      String      @unique
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  places    TourPlace[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([isActive, sortOrder])
}

model TourPlace {
  id           String       @id @default(uuid())
  categoryId   String
  category     TourCategory @relation(fields: [categoryId], references: [id])
  name         String
  slug         String       @unique
  description  String?
  address      String?
  latitude     Float?
  longitude    Float?
  websiteUrl   String?
  phone        String?
  imageUrl     String?
  images       String[]
  openingHours String?
  googleMapUrl String?
  isPublished  Boolean      @default(false)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  @@index([categoryId])
  @@index([isPublished, sortOrder])
}

// ===== FAQ =====

model FaqCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  faqs      Faq[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Faq {
  id          String      @id @default(uuid())
  categoryId  String
  category    FaqCategory @relation(fields: [categoryId], references: [id])
  question    String
  answer      String
  sortOrder   Int         @default(0)
  isPublished Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@index([categoryId])
  @@index([isPublished, sortOrder])
}

// ===== RESERVATION =====

model Reservation {
  id        String            @id @default(uuid())
  name      String
  email     String
  phone     String?
  date      DateTime
  time      String
  guests    Int
  course    String?
  notes     String?
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, date])
}

// ===== CONTACT =====

model Contact {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean       @default(false)
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([isRead, status, createdAt])
}

// ===== MEDIA LIBRARY =====

model Media {
  id          String   @id @default(uuid())
  fileName    String
  url         String
  storagePath String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  alt         String?
  tags        String[]
  folder      String?
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== SEO =====

model SeoMeta {
  id              String   @id @default(uuid())
  pagePath        String   @unique
  title           String?
  description     String?
  keywords        String[]
  ogImage         String?
  ogTitle         String?
  ogDescription   String?
  canonicalUrl    String?
  noIndex         Boolean  @default(false)
  jsonLd          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===== SETTINGS =====

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  group     String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== AUDIT LOG =====

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  module    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ===== ANALYTICS =====

// Aggregated daily analytics — one row per UTC day.
// visitors/pageViews are incremented in real time (atomic UPSERT from the
// track endpoint); topCategories/topDishes/topCountries are JSON top-10
// lists ([{ key, name, count }]) recomputed from raw events by the rollup
// job. Dashboard queries read this table primarily.
model AnalyticsDaily {
  id            String   @id @default(uuid())
  date          DateTime @unique @db.Date
  visitors      Int      @default(0)
  pageViews     Int      @default(0)
  topCategories Json     @default("[]")
  topDishes     Json     @default("[]")
  topCountries  Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("analytics_daily")
}

// Raw tracking events (page_view | view_category | view_dish).
// Source for daily rollup aggregation; retained for 90 days only
// (cleaned by the rollup cron) to stay within Supabase Free limits.
model AnalyticsEvent {
  id           String   @id @default(uuid())
  event        String // page_view | view_category | view_dish
  path         String?
  entityType   String? // menu | drink | buffet
  slug         String?
  country      String? // ISO code from Vercel geo header
  isNewVisitor Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([event, createdAt])
  @@map("analytics_events")
}

// ===== ENUMS =====

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum MediaCoverageCategory {
  TV
  MAGAZINE
  WEB
  YOUTUBE
  INFLUENCER
}
